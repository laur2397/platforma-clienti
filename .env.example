# --- Secret pentru sesiunea de admin (iron-session) ---
# OBLIGATORIU minim 32 caractere. Generează unul nou pentru producție:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=schimba_aceasta_cheie_cu_cel_putin_32_de_caractere_aleatoare

# --- Cont administrator inițial (folosit de scripts/init-admin.ts) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ParolaSchimbaMa123!

# --- Limite uploads ---
# Dimensiunea maximă per fișier (în MB)
MAX_FILE_SIZE_MB=15

# --- Mediu ---
# Setează pe "production" doar pe HTTPS (cookie-ul de sesiune va fi marcat Secure)
NODE_ENV=development

# --- Stocare persistentă (doar producție) ---
# Pe Railway / Fly / etc. montează un volum și pune calea aici. Local lasă gol —
# se folosește process.cwd() (foldere ./data și ./uploads relative la proiect).
# STORAGE_DIR=/app/storage
